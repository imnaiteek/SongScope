# ---------------------------------------------------------------------------
# SongScope configuration. Copy to `.env` (backend reads it from its working dir).
# ---------------------------------------------------------------------------

# Database. Local default is SQLite; docker-compose overrides this with PostgreSQL.
SONGSCOPE_DATABASE_URL=sqlite:///./data/songscope.db
# SONGSCOPE_DATABASE_URL=postgresql+psycopg://songscope:songscope@localhost:5432/songscope

# Where temporary per-job audio is written (deleted after the retention window)
SONGSCOPE_DATA_DIR=./data

# Limits
SONGSCOPE_MAX_UPLOAD_MB=200
SONGSCOPE_MAX_DURATION_SECONDS=900
SONGSCOPE_JOB_TIMEOUT_SECONDS=1800
SONGSCOPE_MAX_CONCURRENT_JOBS=2
SONGSCOPE_RATE_LIMIT_PER_MINUTE=20

# Audio retention (minutes). Results are kept; audio is deleted after this window.
SONGSCOPE_AUDIO_RETENTION_MINUTES=60
SONGSCOPE_KEEP_SOURCE_AUDIO=false
# Reuse results for identical content / the same YouTube video
SONGSCOPE_CACHE_RESULTS=true

# CORS: comma-separated frontend origins
SONGSCOPE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Run jobs inside the API process pool (true) or in `python -m songscope_api.worker` (false)
SONGSCOPE_EMBEDDED_WORKER=true

# YouTube (subject to YouTube's terms and copyright). Optional Netscape cookies file for bot checks.
SONGSCOPE_ENABLE_YOUTUBE=true
# SONGSCOPE_YOUTUBE_COOKIES_FILE=/path/to/cookies.txt

# Source separation (requires the optional PyTorch + Demucs install)
SONGSCOPE_ENABLE_STEMS=true
SONGSCOPE_STEMS_MODEL=htdemucs

# Optional AI explanations (runs only after DSP analysis, never produces numbers)
# ANTHROPIC_API_KEY=
SONGSCOPE_LLM_MODEL=claude-opus-5

# Optional explicit binaries (otherwise system ffmpeg, then the imageio-ffmpeg bundle)
# FFMPEG_PATH=
# FFPROBE_PATH=
FFMPEG_THREADS=2

# Frontend (build-time): where the browser reaches the API
NEXT_PUBLIC_API_URL=http://localhost:8000
