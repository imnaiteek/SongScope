{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://songscope.local/schemas/analysis-result/1.json",
  "title": "SongScope analysis result",
  "description": "Output of songscope_engine.pipeline.run_analysis (schema_version 1). Every analysis block carries confidence metadata; see $defs/confident. Large arrays (waveform peaks, spectrogram, chromagram, contours) are downsampled for transport.",
  "type": "object",
  "required": ["schema_version", "engine_version", "metadata", "overview", "summary", "tempo", "rhythm", "meter", "key", "chords", "progression", "harmony", "structure", "drums", "pitch", "loudness", "spectrum", "waveform", "errors", "warnings"],
  "properties": {
    "schema_version": { "const": 1 },
    "engine_version": { "type": "string" },
    "metadata": {
      "type": "object",
      "required": ["duration", "source_type"],
      "properties": {
        "title": { "type": ["string", "null"] },
        "artist": { "type": ["string", "null"] },
        "album": { "type": ["string", "null"] },
        "year": { "type": ["string", "null"] },
        "duration": { "type": "number", "description": "seconds" },
        "sample_rate": { "type": ["integer", "null"] },
        "channels": { "type": ["integer", "null"] },
        "bit_depth": { "type": ["integer", "null"], "description": "only for lossless/PCM sources" },
        "bit_rate": { "type": ["integer", "null"] },
        "format": { "type": ["string", "null"] },
        "codec": { "type": ["string", "null"] },
        "file_size": { "type": "integer" },
        "source_type": { "enum": ["upload", "youtube"] },
        "youtube": { "type": ["object", "null"] }
      }
    },
    "overview": {
      "type": "object",
      "properties": {
        "bpm": { "type": ["number", "null"] },
        "key": { "type": ["string", "null"] },
        "meter": { "type": ["string", "null"], "description": "null when the meter could not be determined reliably" },
        "duration": { "type": "number" },
        "integrated_lufs": { "type": ["number", "null"] },
        "overall_confidence": { "$ref": "#/$defs/unit" },
        "overall_confidence_level": { "$ref": "#/$defs/level" }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "sentences": { "type": "array", "items": { "type": "string" } },
        "highlights": { "type": "array" }
      }
    },
    "tempo": {
      "allOf": [{ "$ref": "#/$defs/confident" }],
      "properties": {
        "bpm": { "type": ["number", "null"] },
        "category": { "enum": ["Very Slow", "Slow", "Moderate", "Fast", "Very Fast", null] },
        "alternative_bpm": { "type": ["number", "null"] },
        "alternative_relation": { "enum": ["half-time", "double-time", null] },
        "alternatives": { "type": "array" },
        "octave_ambiguous": { "type": "boolean" },
        "estimates": { "type": "object", "additionalProperties": { "type": ["number", "null"] } },
        "stability": { "type": ["number", "null"] },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/span", "properties": { "bpm": { "type": "number" } } } },
        "has_tempo_changes": { "type": "boolean" },
        "curve": { "type": "object" }
      }
    },
    "rhythm": {
      "type": "object",
      "properties": {
        "beats": { "type": "array", "items": { "type": "number" } },
        "downbeats": { "type": "array", "items": { "type": "number" } },
        "beat_interval_s": { "type": ["number", "null"] },
        "tempo_stability": { "type": ["number", "null"] },
        "onset_density": { "type": "number" },
        "rhythm_density": { "type": "number" },
        "syncopation": { "type": "number" }
      }
    },
    "meter": {
      "allOf": [{ "$ref": "#/$defs/confident" }],
      "properties": {
        "signature": { "type": ["string", "null"], "examples": ["4/4", "3/4", "6/8"] },
        "reliable": { "type": "boolean" },
        "tendency": { "type": ["string", "null"], "description": "best guess, shown as uncertain when not reliable" },
        "beats_per_bar": { "type": ["integer", "null"] },
        "subdivision": { "enum": ["duple", "triple", null] },
        "candidates": { "type": "array" }
      }
    },
    "key": {
      "allOf": [{ "$ref": "#/$defs/confident" }],
      "properties": {
        "key": { "type": ["string", "null"], "examples": ["E Major"] },
        "tonic": { "type": ["string", "null"] },
        "mode": { "enum": ["major", "minor", null] },
        "alternative_key": { "type": ["string", "null"] },
        "most_prominent_pitch_class": { "type": "string" },
        "scale_confidence": { "$ref": "#/$defs/unit" },
        "tuning_cents": { "type": "number" },
        "changes": { "type": "array" }
      }
    },
    "chords": {
      "allOf": [{ "$ref": "#/$defs/confident" }],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start", "end", "chord", "confidence"],
            "properties": {
              "start": { "type": "number" },
              "end": { "type": "number" },
              "chord": { "type": "string", "description": "\"N\" = no chord" },
              "root": { "type": ["integer", "null"], "minimum": 0, "maximum": 11 },
              "quality": { "enum": ["maj", "min", "dim", "aug", "sus2", "sus4", "7", "maj7", "min7", null] },
              "confidence": { "$ref": "#/$defs/unit" }
            }
          }
        },
        "changes_per_minute": { "type": ["number", "null"] }
      }
    },
    "progression": { "allOf": [{ "$ref": "#/$defs/confident" }] },
    "harmony": { "allOf": [{ "$ref": "#/$defs/confident" }] },
    "structure": {
      "allOf": [{ "$ref": "#/$defs/confident" }],
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start", "end", "label", "display_label", "group", "confidence"],
            "properties": {
              "label": { "type": "string" },
              "display_label": { "type": "string", "description": "prefixed with \"Possible\" when uncertain" },
              "group": { "type": "string", "description": "acoustic repetition group A, B, C…" }
            }
          }
        }
      }
    },
    "drums": { "allOf": [{ "$ref": "#/$defs/confident" }], "properties": { "estimated": { "const": true } } },
    "pitch": { "allOf": [{ "$ref": "#/$defs/confident" }] },
    "loudness": {
      "allOf": [{ "$ref": "#/$defs/confident" }],
      "properties": {
        "integrated_lufs": { "type": ["number", "null"] },
        "true_peak_dbtp": { "type": ["number", "null"] },
        "loudness_range_lu": { "type": ["number", "null"] },
        "dynamic_range_db": { "type": ["number", "null"] }
      }
    },
    "spectrum": { "allOf": [{ "$ref": "#/$defs/confident" }] },
    "waveform": {
      "type": "object",
      "properties": { "peaks_per_second": { "type": "number" }, "peaks": { "type": "array", "items": { "type": "number" } } }
    },
    "stems": { "type": ["object", "null"] },
    "errors": { "type": "array", "items": { "type": "object", "properties": { "stage": { "type": "string" }, "message": { "type": "string" } } } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "timings": { "type": "object" }
  },
  "$defs": {
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "level": { "enum": ["high", "medium", "low"] },
    "span": { "type": "object", "required": ["start", "end"], "properties": { "start": { "type": "number" }, "end": { "type": "number" } } },
    "confident": {
      "type": "object",
      "required": ["confidence", "confidence_level", "status"],
      "properties": {
        "available": { "type": "boolean" },
        "confidence": { "$ref": "#/$defs/unit" },
        "confidence_level": { "$ref": "#/$defs/level", "description": "high >= 0.75, medium >= 0.5, low otherwise" },
        "status": { "enum": ["detected", "estimated", "inferred", "uncertain"] },
        "message": { "type": ["string", "null"] }
      }
    }
  }
}
